# Recommended: npm run infra:init generates .env with a random local password.
# Alternative: copy this file to .env, chmod 600 .env, and set a unique value.
# Use 32–128 letters, digits, underscores or hyphens. No paid API keys needed.
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
# Fixed local database/user: casegraph. Evidence directory: .local/evidence.
# Changing a password here does not rotate credentials in an existing DB volume.

# Local fictional role simulation only. Never enable for production or real data.
DEMO_MODE=false

# Optional future TigerGraph tunnel: enable via exported process environment only.
# TIGERGRAPH_ENABLED=true TIGERGRAPH_LOCAL_PORT=14240 npm run dev:demo
# Default disabled. Server token belongs in private .local/tigergraph-app.token,
# never in this file or a VITE_ variable. See graph/README.md before configuring.

# Public Savanna alternative (export into backend process; .env is not loaded for graph flags):
# TIGERGRAPH_ENDPOINT=https://<workspace-id>.i.tgcloud.io
# TIGERGRAPH_AUTH_MODE=bearer  # or secret for GSQL-Secret authentication
# Private .local/tigergraph-app.token holds the selected database credential (mode 600).
# Never use the control-plane API key or an internal .svc URL.
