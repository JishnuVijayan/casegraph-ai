# Recommended: npm run infra:init generates .env with a random local password.
# Alternative: copy this file to .env, chmod 600 .env, and set a unique value.
# Use 32–128 letters, digits, underscores or hyphens.
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
# Fixed local database/user: casegraph. Evidence directory: .local/evidence.
# Changing a password here does not rotate credentials in an existing DB volume.

# Local fictional role simulation only. Never enable for production or real data.
DEMO_MODE=false

# --- Core services (ap-south-1, $20 hard cap). Textract, Bedrock and TigerGraph are ON by default. ---
# Set a flag to `false` only for offline work or tests. Startup aborts if a core service is down
# (ALLOW_DEGRADED=true starts anyway; graph leads then show unavailable).
# Prefer `aws configure` or shell exports for AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
# Never commit real keys. See docs/AWS_DEMO.md.
AWS_REGION=ap-south-1
TEXTRACT_ENABLED=true
BEDROCK_ENABLED=true
# Enable a cheap model in the Bedrock console for ap-south-1 first.
# In ap-south-1 use an inference profile, e.g. apac.amazon.nova-micro-v1:0
BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0

# TigerGraph over the SSH tunnel (on by default; set TIGERGRAPH_ENABLED=false to opt out).
# TIGERGRAPH_LOCAL_PORT=14240 Server token belongs in private .local/tigergraph-app.token,
# never in this file or a VITE_ variable. See graph/README.md and docs/AWS_DEMO.md.

# Voice typing (Sarvam AI speech-to-text). Leave empty to use the browser's built-in dictation instead.
SARVAM_API_KEY=
# SARVAM_STT_MODEL=saaras:v4
