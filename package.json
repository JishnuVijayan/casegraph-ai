{
  "name": "casegraph-ai",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @casegraph/api\" \"npm run dev -w @casegraph/web\"",
    "build": "npm run build --workspaces",
    "test": "npm run infra:test && npm run graph:test && npm run test --workspaces",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces && npm run typecheck:e2e",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "infra:init": "node infra/manage.mjs init",
    "infra:config": "node infra/manage.mjs config",
    "infra:up": "node infra/manage.mjs up",
    "infra:down": "node infra/manage.mjs down",
    "infra:status": "node infra/manage.mjs status",
    "infra:test": "node --test infra/test/*.test.mjs",
    "infra:smoke:db": "node infra/db-smoke.mjs",
    "infra:smoke:storage": "node infra/storage-smoke.mjs",
    "db:generate": "npm run db:generate -w @casegraph/api",
    "db:migrate": "npm run build -w @casegraph/api && node infra/database.mjs migrate",
    "seed:synthetic": "npm run build -w @casegraph/api && node infra/database.mjs seed",
    "db:verify": "npm run build -w @casegraph/api && node infra/database.mjs verify",
    "test:auth": "node infra/auth-test.mjs",
    "dev:demo": "DEMO_MODE=true npm run dev",
    "test:evidence": "node infra/evidence-test.mjs",
    "test:ocr": "node infra/extraction-test.mjs",
    "test:claims": "node infra/claims-test.mjs",
    "test:clarifications": "node infra/clarifications-test.mjs",
    "test:prepare": "node infra/prepare-test.mjs",
    "test:exports": "node infra/exports-test.mjs",
    "test:investigations": "node infra/investigations-test.mjs",
    "test:security": "npm test && npm run test:auth && npm run test:evidence && npm run test:ocr && npm run test:claims && npm run test:clarifications && npm run test:prepare && npm run test:exports && npm run test:investigations && npm run test:e2e",
    "test:e2e": "npm run build -w @casegraph/api && node infra/e2e.mjs",
    "test:e2e:live": "npm run build -w @casegraph/api && node infra/e2e.mjs --live-graph",
    "graph:preflight": "node infra/tigergraph.mjs preflight",
    "graph:config": "node infra/tigergraph.mjs config",
    "graph:health": "node infra/tigergraph.mjs health",
    "graph:bundle": "node graph/bundle.mjs",
    "graph:test": "node --test graph/test/*.test.mjs",
    "graph:verify-live": "node graph/verify-live.mjs",
    "seed:generate-bootstrap": "node data/synthetic/generate-bootstrap.mjs",
    "aws:tg:create": "node infra/aws/ec2-tigergraph.mjs create",
    "aws:tg:status": "node infra/aws/ec2-tigergraph.mjs status",
    "aws:tg:stop": "node infra/aws/ec2-tigergraph.mjs stop",
    "aws:tg:start": "node infra/aws/ec2-tigergraph.mjs start",
    "aws:tg:destroy": "node infra/aws/ec2-tigergraph.mjs destroy",
    "aws:tg:tunnel-hint": "node infra/aws/ec2-tigergraph.mjs tunnel-hint"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
