# Copied to /opt/casegraph/secrets/app.env on the app EC2 (mode 0600). Never commit real values.
DEMO_MODE=true
NODE_ENV=production
PUBLIC_ORIGIN=https://YOUR_HOST.duckdns.org
# Officer sign-in gate (demo only). Default in code is HHGOAOFFICER if unset.
OFFICER_DEMO_PASSWORD=HHGOAOFFICER
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
AWS_REGION=ap-south-1
TEXTRACT_ENABLED=true
BEDROCK_ENABLED=true
BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0
TIGERGRAPH_ENABLED=true
TIGERGRAPH_LOCAL_PORT=14240
# true lets the API boot while TigerGraph is still warming after EC2 start
ALLOW_DEGRADED=true
